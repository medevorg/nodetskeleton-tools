{
  "name": "tskeleton-tools",
  "version": "1.0.0",
  "description": "tools for nodetskeleton template",
  "scripts": {
    "test": "npm run build && jest --coverage --collectCoverageFrom=src/**",
    "build": "rm -rf dist/* && tsc --sourceMap false",
    "lint": "tsc --noEmit && eslint \"**/*.{js,ts}\" --quiet --fix",
    "pretty-quick": "pretty-quick",
    "pretty-check": "pretty-quick --check",
    "pre-commit": "npm run lint && npm run pretty-quick --staged && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medevorg/nodetskeleton-tools.git"
  },
  "keywords": [
    "nodejs",
    "tskeleton",
    "tools",
    "clean architecture",
    "work flow"
  ],
  "author": "Vickodev<harvic3@proton.me>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/medevorg/nodetskeleton-tools/issues"
  },
  "homepage": "https://github.com/medevorg/nodetskeleton-tools#readme",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.9",
    "@types/node-fetch": "^2.6.12",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.6",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "jest-mock-extended": "^3.0.7",
    "prettier": "^3.5.3",
    "pretty-quick": "^4.1.1",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run pre-commit"
    }
  }
}
